{# NESTED must_match_fields — the case the generated CRD cannot express.

   The proto type is google.protobuf.Struct and the field's own doc comment promises
   "strings, numbers, booleans, and nested fields". But crdgen emits
   `additionalProperties: true` for Struct (schemagen.go, the .google.protobuf.Struct
   case), i.e. "any key allowed, values unspecified" — and a value with no schema has no
   known sub-fields, so the API server's strict decoding refuses this manifest with:

     unknown field "spec.generic_oidc.must_match_fields.nested.deep"

   Nothing here is otherwise invalid; it is the same token as op-cr-flat with one extra
   level of nesting. Once crdgen emits x-kubernetes-preserve-unknown-fields instead (as
   it already does for the Labels custom type just above that case), this is accepted and
   round-trips all the way into Teleport. #}
apiVersion: resources.teleport.dev/v2
kind: TeleportProvisionToken
metadata:
  name: op-oidc-nested
  namespace: teleport
spec:
  roles: [Node]
  join_method: generic_oidc
  generic_oidc:
    issuer: "https://oidc.{{ lab_domain }}:8443"
    audience: "{{ fqdn }}/generic-oidc"
    must_match_fields:
      org: ethernet-fyi
      nested:
        deep: harness-nested
    allow_any:
      - conditions:
          - attribute: sub
            eq: {value: "{{ oidc_subject }}"}
