{# The SCOPED app agent: an App-only Teleport service that joins with a scoped token and
   therefore registers `{{ app_name }}` INSIDE {{ scope }} (lib/srv/app/server.go stamps the
   agent's own scope pin onto every app it registers).

   `token_name` is the scoped token's Scope-Qualified Name with the secret appended:
   `<scope>::<name>:<base64url(secret)>`, the encoding lib/scopes/joining/token.go
   EncodeScopedToken produces and the join path decodes. The bare SQN is NOT enough for the
   `token` method — the secret is the challenge.

   NOTE: a scoped app must NOT set `public_addr` — lib/service/service.go
   validateScopedAppRegistration rejects it, because the address is derived from the app
   name + scope (a 32-char base32 hash subdomain of the proxy, see lib/scopes/app/appsqdn.go
   ScopedAppPublicAddr). That is also why this module reaches the app through tbot's
   application-tunnel rather than over the derived hostname: the harness wildcard cert and
   DNS record cover `*.lab.<domain>` only, one level shallower than that address. #}
version: v3
teleport:
  nodename: {{ cluster_id }}-app-agent
  data_dir: /var/lib/teleport
  diag_addr: 0.0.0.0:3000
  proxy_server: {{ fqdn }}:{{ port }}
  log: {output: stderr, severity: INFO}
  join_params:
    method: token
    token_name: "{{ scope }}::app-agent-token:{{ app_agent_secret | b64url }}"
auth_service: {enabled: "no"}
proxy_service: {enabled: "no"}
ssh_service: {enabled: "no"}
app_service:
  enabled: "yes"
  apps:
    - name: {{ app_name }}
      uri: http://httpbin:8080
      labels: {harness: scoped}
