{# SCOPED agent joining via generic_oidc with discovery. `token_name` is the token's
   Scope-Qualified Name `<scope>::<name>`, NOT its bare metadata.name — see the `scope`
   note in render.yaml for why (a bare name here fails as "token expired or not found"). #}
version: v3
teleport:
  nodename: {{ cluster_id }}-agent-scoped-discovery
  data_dir: /var/lib/teleport
  proxy_server: {{ fqdn }}:{{ port }}
  log: {output: stderr, severity: INFO}
  join_params:
    method: generic_oidc
    token_name: {{ scope }}::generic-oidc-scoped-agent-discovery
    generic_oidc:
      command: ["curl", "-fsSk", "https://oidc:8443/token?sub=test-agent"]
auth_service: {enabled: "no"}
proxy_service: {enabled: "no"}
ssh_service:
  enabled: "yes"
  labels: {test: generic-oidc, variant: scoped-discovery}
