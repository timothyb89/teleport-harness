#!/usr/bin/env bash
# teleport-harness CLI: spin up disposable dockerized Teleport clusters from any
# clone/branch (or a released package/binary), run gated test plans, and produce
# inspectable reports.
#
#   cluster doctor
#   cluster validate [module]
#   cluster build   <source> [--ent]
#   cluster up      <module> <source> [--id <id>] [--ent]
#   cluster run-plan <plan|module> <source> [--features a,b] [--version vNN] [--id <id>]
#   cluster ls
#   cluster logs    <id> [service]
#   cluster web     <id>
#   cluster report  <id>
#   cluster share   <run-bundle|id> [--public]
#   cluster teardown <id|--all>
#
# <source> is exactly one of (mutually exclusive):
#   --repo <clone>       build from the clone's currently checked-out tree
#   --package <tar.gz>   a released teleport-*-bin.tar.gz (no toolchain needed)
#   --binary <path>      prebuilt teleport + tctl/tbot/tsh in one directory
# Enterprise sources need a license: --license-file <pem> (or HARNESS_LICENSE_FILE, or put
# it in targets/<target>.env). A --repo build falls back to the clone's bundled test license.
# Modules that BUILD from the clone (terraform provider, k8s operator, docs) gate out
# with a reason when the source is a package/binary.
#
# Global flags (before or after the subcommand): --target <name> (targets/<name>.env)
set -euo pipefail

# Resolve symlinks so the CLI works when invoked via a symlink (e.g. ~/bin/th).
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
LIB="$(cd "$(dirname "$SELF")/../lib" && pwd)"
. "$LIB/common.sh"
. "$LIB/ingress.sh"
. "$LIB/build.sh"
. "$LIB/doctor.sh"
. "$LIB/cluster.sh"
. "$LIB/admin.sh"
. "$LIB/verify.sh"
[ -f "$LIB/agent.sh" ] && . "$LIB/agent.sh"
[ -f "$LIB/plan.sh" ] && . "$LIB/plan.sh"
[ -f "$LIB/report.sh" ] && . "$LIB/report.sh"
[ -f "$LIB/share.sh" ] && . "$LIB/share.sh"

# Parse global + passthrough flags into env; collect positionals.
POS=()
export REPO="${REPO:-}" PACKAGE="${PACKAGE:-}" BINARY="${BINARY:-}"
export ID="${ID:-}" ENT="${ENT:-0}" TARGET="${TARGET:-default}" FEATURES="${FEATURES:-}" VERSION="${VERSION:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --repo)     REPO="$(cd "$2" && pwd)"; shift 2 ;;
    --package)  PACKAGE="$2"; shift 2 ;;   # absolutized by resolve_source (lib/build.sh)
    --binary)   BINARY="$2"; shift 2 ;;
    # Same knob as the env var (which targets/<target>.env can also set), so there is one
    # code path in cluster_up; the flag just wins because it is the more specific ask.
    --license-file) HARNESS_LICENSE_FILE="$2"; export HARNESS_LICENSE_FILE; shift 2 ;;
    --id)       ID="$2"; shift 2 ;;
    --target)   TARGET="$2"; shift 2 ;;
    --features) FEATURES="$2"; shift 2 ;;
    --version)  VERSION="$2"; shift 2 ;;
    --ent)      ENT=1; shift ;;
    -h|--help) sed -n '2,27p' "$0"; exit 0 ;;
    *) POS+=("$1"); shift ;;
  esac
done
set -- "${POS[@]:-}"
cmd="${1:-}"; shift || true

case "$cmd" in
  doctor)   doctor ;;
  validate) pybrain validate "$@" ;;
  build)    load_target; build_image ;;
  up)       cluster_up "$@" ;;
  run-plan) command -v run_plan >/dev/null 2>&1 || die "plan runner not installed yet"; run_plan "$@" ;;
  ls)       cluster_ls ;;
  logs)     cluster_logs "$@" ;;
  admin)    cluster_admin "$@" ;;
  tctl)     cluster_tctl "$@" ;;
  tsh)      cluster_tsh "$@" ;;
  web)      cluster_web "$@" ;;
  report)   command -v cluster_report >/dev/null 2>&1 || die "reporter not installed yet"; cluster_report "$@" ;;
  share)    command -v cluster_share >/dev/null 2>&1 || die "sharer not installed yet"; cluster_share "$@" ;;
  teardown) cluster_teardown "$@" ;;
  ""|help)  sed -n '2,27p' "$0" ;;
  *) die "unknown command: $cmd (try: doctor validate build up run-plan ls logs web report share teardown)" ;;
esac
